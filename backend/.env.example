# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client (Web application)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# The public URL of THIS backend once deployed (Render/Railway), no trailing slash
BACKEND_URL=https://your-backend.onrender.com

# Meta for Developers -> your app -> Settings -> Basic
META_APP_ID=
META_APP_SECRET=

# The numeric ID of your Instagram Business/Creator account (via Graph API Explorer:
# GET /me/accounts, then GET /{page-id}?fields=instagram_business_account)
IG_BUSINESS_ACCOUNT_ID=

# Cloudinary dashboard -> Account Details
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
